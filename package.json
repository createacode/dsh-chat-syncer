{
  "name": "dsh-chat-syncer",
  "version": "0.15.0",
  "type": "module",
  "description": "多端会话同步助手：DSH multi-device session sync through a user-owned private Gitee or GitHub repository, with per-user/per-device folders, a shared latest revision, consent gate, optional AES-256-GCM packages, sidebar workspace registration, import/export and deletion.",
  "license": "AGPL-3.0-only",
  "author": "dsh-chat-syncer contributors",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/user_gitee/dsh-chat-sync.git"
  },
  "homepage": "https://gitee.com/user_gitee/dsh-chat-sync#readme",
  "bugs": {
    "url": "https://gitee.com/user_gitee/dsh-chat-sync/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "sync",
    "gitee",
    "github",
    "session",
    "aes-256-gcm"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "test",
    "docs",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node --check index.js && node --check client.js",
    "dist": "pnpm pack --pack-destination dist"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
